GOOGLE_API_KEY=sua_chave_do_google
OPENAI_API_KEY=sk-sua_chave_da_openai_aqui
SENIOR_USER=email@tenant.com.br
SENIOR_PASS=password123
PINECONE_API_KEY==chave_pinecone
PINECONE_INDEX_NAME=nome-do-seu-index-aqui
ELEVENLABS_API_KEY=sua_chave_aqui

# =========================================================
# Azure TTS Premium Voice (opcional)
# =========================================================
# Necessário APENAS para a voz premium (en-US-AvaMultilingualNeural).
# As vozes gratuitas (Francisca, Brenda, Antônio, Andrew) funcionam
# sem estas variáveis via edge-tts.
AZURE_TTS_KEY=your_azure_tts_key_here
AZURE_TTS_REGION=brazilsouth

# Web Knowledge Ingestion Pipeline (RAG)
# Extraction backend: "crawl4ai" (self-hosted) or "firecrawl" (managed service)
EXTRACTION_BACKEND=crawl4ai
# Firecrawl API key (only required if using firecrawl backend)
FIRECRAWL_API_KEY=fc-sua_chave_firecrawl_aqui

# IMPORTANTE: Índice Pinecone para RAG
# OPÇÃO 1 (RECOMENDADO): Usar índice separado para testes
# - Crie um novo índice no Pinecone Console (ex: "senior-training-os-rag-test")
# - Dimensões: 3072 (text-embedding-3-large)
# - Métrica: cosine
# - Isso protege seus dados de produção durante testes
# PINECONE_INDEX_NAME=senior-training-os-rag-test

# OPÇÃO 2: Usar o mesmo índice de produção
# - Os vetores RAG serão segregados por namespace (ex: "hcm", "financeiro")
# - Não interfere com vetores existentes em outros namespaces
# - Mais econômico (um único índice)
# PINECONE_INDEX_NAME=senior-training-os
AURA_API_SECRET=uma_chave_secreta_qualquer

# Nome do operador exibido na interface (dashboard e VLA)
APP_USER_NAME=Seu Nome Aqui

# Seletores CSS adicionais para blur automático de campos sensíveis (separados por vírgula)
# Exemplo: BLUR_SELECTORS=.cpf-field,.token-field,[data-sensitive]
BLUR_SELECTORS=

# =========================================================
# AURA Smart Navigation Fallback Configuration
# =========================================================

# Enable/disable navigation fallback feature
NAVIGATION_FALLBACK_ENABLED=True

# Path to the navigation index SQLite database
ROTEIRO_INDEX_DB=roteiro_index.db

# LRU cache size for frequently accessed navigation paths
ROTEIRO_INDEX_CACHE_SIZE=100

# Timeout for navigation step execution (milliseconds)
NAVIGATION_STEP_TIMEOUT_MS=2000

# Timeout for element visibility check (milliseconds)
ELEMENT_VISIBILITY_CHECK_TIMEOUT_MS=500

# =========================================================
# Suporte a Sites Genéricos (CAPTURE_ADAPTER=generic)
# =========================================================
# Para usar a plataforma com qualquer site web (não apenas Senior X),
# configure as variáveis abaixo. Basta alterar CAPTURE_ADAPTER para "generic"
# e preencher TARGET_URL com o endereço do sistema alvo.

# Tipo de adapter de captura: "senior_x" (padrão) ou "generic"
# - senior_x: usa login e heurísticas específicas do Senior X ERP
# - generic: permite mapear qualquer site web configurável via variáveis abaixo
CAPTURE_ADAPTER=senior_x

# URL do site alvo (obrigatória quando CAPTURE_ADAPTER=generic)
# Deve iniciar com http:// ou https://
# TARGET_URL=https://meu-sistema.exemplo.com.br/portal

# Nome do sistema alvo para exibição em prompts de IA e logs (opcional)
# Se não definido, será usado "Site Genérico" como fallback
# TARGET_SYSTEM_NAME=Portal RH Corporativo

# Requer login automático? Valores aceitos: "true" ou "false" (padrão: false)
# Se false, o robô navega direto para TARGET_URL sem autenticação
# LOGIN_REQUIRED=false

# Credenciais de login (obrigatórias quando LOGIN_REQUIRED=true)
# LOGIN_USER=usuario@empresa.com.br
# LOGIN_PASS=senha_segura_aqui

# Seletores CSS para o fluxo de login automático (obrigatórios quando LOGIN_REQUIRED=true)
# Use seletores CSS válidos que identifiquem os campos de login no site alvo
# LOGIN_SELECTOR_USER=input[name='email']
# LOGIN_SELECTOR_PASS=input[type='password']
# LOGIN_SELECTOR_SUBMIT=button[type='submit']

# ─── Exemplo completo para site genérico COM login ───────────────────────
# CAPTURE_ADAPTER=generic
# TARGET_URL=https://erp.minhaempresa.com.br/login
# TARGET_SYSTEM_NAME=ERP Corporativo
# LOGIN_REQUIRED=true
# LOGIN_USER=analista@minhaempresa.com.br
# LOGIN_PASS=minha_senha_segura
# LOGIN_SELECTOR_USER=#username
# LOGIN_SELECTOR_PASS=#password
# LOGIN_SELECTOR_SUBMIT=button.btn-login

# ─── Exemplo completo para site genérico SEM login ───────────────────────
# CAPTURE_ADAPTER=generic
# TARGET_URL=https://docs.exemplo.com.br/manual
# TARGET_SYSTEM_NAME=Base de Conhecimento
# LOGIN_REQUIRED=false
