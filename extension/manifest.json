{
  "manifest_version": 3,
  "name": "Aura - Senior Success Hub",
  "description": "Assistente IA contextual para o sistema Senior X — DAP com RAG.",
  "version": "2.0",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "background": {
    "service_worker": "background.js",
    "_config_injection_note": "aura_config.js é carregado via importScripts() no background.js. Para produção, substitua aura_config.js com os valores reais antes de empacotar a extensão. Nunca commite tokens reais."
  },
  "content_scripts": [
    {
      "matches": ["https://*.senior.com.br/*"],
      "js": ["shield.js", "dotlottie-player.js", "content.js"],
      "css": ["style.css"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://*.senior.com.br/*"],
      "js": ["bridge.js"],
      "world": "ISOLATED",
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "aura.json",
        "aura_config.js",
        "modules/aura_state.js",
        "modules/aura_feedback.js",
        "modules/aura_ui.js",
        "modules/aura_dom_mapper.js",
        "modules/aura_spotlight.js",
        "modules/aura_gps_engine.js",
        "modules/aura_mission_engine.js",
        "modules/aura_assist_engine.js",
        "guided_execution.js",
        "checklist_widget.js",
        "hesitation_detector.js",
        "nps_modal.js"
      ],
      "matches": ["https://*.senior.com.br/*"]
    }
  ]
}